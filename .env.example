# MonCastle — root env template (copy to .env and fill in)

# Private key for contract deployment (DO NOT COMMIT)
PRIVATE_KEY=0x_your_private_key_here
PHRASE=your mnemonic phrase here

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=moncastle
# Or: DATABASE_URL=postgres://user:pass@host:5432/dbname
